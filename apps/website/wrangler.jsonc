{
  "name": "coworkany-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "coworkany.com", "custom_domain": true },
    { "pattern": "www.coworkany.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html"]
  }
}
