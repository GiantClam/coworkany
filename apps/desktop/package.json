{
  "name": "@coworkany/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/clear-desktop-dev-processes.mjs 1420 && pnpm run build:host && pnpm run build:skills && pnpm run build:agents && vite --host 127.0.0.1",
    "build": "pnpm run build:runtime && pnpm run build:host && pnpm run build:skills && pnpm run build:agents && tsc -p tsconfig.json --noEmit && vite build",
    "package:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package-desktop-zip.ps1",
    "package:portable-zip": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package-desktop-zip.ps1 -Portable",
    "build:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/stage-desktop-runtime.ps1",
    "build:host": "node ../../scripts/clean-desktop-host.mjs && esbuild runtime/host.ts --bundle --platform=node --format=esm --outfile=dist-runtime/host.mjs --external:node:* --external:@lancedb/lancedb && esbuild runtime/knowledge-service.ts --bundle --platform=node --format=esm --outfile=dist-runtime/knowledge.mjs --external:node:* --external:@lancedb/lancedb",
    "build:skills": "node ../../scripts/generate-shared-skill-catalog.mjs && node ../../scripts/bundle-desktop-skills.mjs && node ../../scripts/validate-shared-skill-catalog.mjs ../../content/skills dist-runtime/skill-catalog.json --allow-extra=ppt-master --allow-extra=dashi-ppt",
    "build:agents": "node ../../scripts/generate-desktop-agency-agent-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:release": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:real-providers": "node ../../scripts/test-desktop-real-providers.mjs",
    "test:real-providers:video": "node ../../scripts/test-desktop-real-providers.mjs --video-only",
    "test:real-providers:audio": "node ../../scripts/test-desktop-real-providers.mjs --audio-only",
    "test:real-providers:music": "node ../../scripts/test-desktop-real-providers.mjs --music-only",
    "test:real-providers:image": "node ../../scripts/test-desktop-real-providers.mjs --image-only",
    "test:real-parallel": "node ../../scripts/desktop-real-parallel-regression.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.82",
    "@coworkany/knowledge-runtime": "workspace:*",
    "@coworkany/media-runtime": "workspace:*",
    "@coworkany/provider-runtime": "workspace:*",
    "@coworkany/runtime-contracts": "workspace:*",
    "@coworkany/workbench-client": "workspace:*",
    "@coworkany/workbench-ui": "workspace:*",
    "@coworkany/workflow-core": "workspace:*",
    "@lancedb/lancedb": "0.37.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite": "^6.3.5"
  }
}
