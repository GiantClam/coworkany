{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoworkAny",
  "version": "0.1.1",
  "identifier": "com.coworkany.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @coworkany/desktop dev",
    "beforeBuildCommand": "pnpm --filter @coworkany/desktop build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "CoworkAny", "width": 1360, "height": 860, "minWidth": 1080, "minHeight": 720, "resizable": true, "alwaysOnTop": false }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; img-src 'self' blob:; media-src 'self' blob:; frame-src 'self' blob:" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/coworkany-icon.ico"],
    "resources": ["../dist-runtime/host.mjs", "../dist-runtime/knowledge.mjs", "../dist-runtime/skills", "../dist-runtime/agents", "../dist-runtime/skill-catalog.json", "../dist-runtime/agency-agent-manifest.json", "../dist-runtime/runtime", "../dist-runtime/install-desktop-runtime.ps1", "../dist-runtime/runtime-manifest-crypto.mjs"],
    "targets": ["nsis"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
